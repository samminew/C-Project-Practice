# 20892768 - MATH 458 Part I (serial)
CC      = gcc
CFLAGS  = -O2 -Wall -Wextra -std=c11
SRC     = 20892768_main.c 20892768_vector.c 20892768_matrix.c
OBJ     = $(SRC:.c=.o)
BIN     = a.out
DATA    = 20892768_serial.txt
PLOT    = 20892768_serial_plot.png
NS      = 500 1000 2000 4000

.PHONY: all run plot clean

all: $(BIN)

$(BIN): $(OBJ)
	$(CC) $(CFLAGS) -o $@ $(OBJ)

20892768_main.o: 20892768_main.c 20892768_vector.h 20892768_matrix.h
	$(CC) $(CFLAGS) -c 20892768_main.c -o $@

20892768_vector.o: 20892768_vector.c 20892768_vector.h
	$(CC) $(CFLAGS) -c 20892768_vector.c -o $@

20892768_matrix.o: 20892768_matrix.c 20892768_matrix.h
	$(CC) $(CFLAGS) -c 20892768_matrix.c -o $@

# main.c writes results itself (appends to $(DATA)); this target just
# clears any old data file, then runs the binary once per N value.
run: $(BIN)
	@rm -f $(DATA)
	@for n in $(NS); do \
		echo "=== N=$$n ==="; \
		./$(BIN) $$n; \
	done
	@echo "Wrote $(DATA)"

plot: $(DATA)
	gnuplot -e "set terminal pngcairo size 1400,900 font 'Arial,14'; \
set output '$(PLOT)'; set title '20892768 Part I serial timings'; \
set xlabel 'Problem size N'; set ylabel 'Wall time (s)'; set key left top; set grid; set logscale y; \
plot '$(DATA)' u 1:2 w lp lw 2 pt 7 title 'V.V', \
     '' u 1:3 w lp lw 2 pt 5 title 'M.V', '' u 1:4 w lp lw 2 pt 9 title 'M.M'"
	@echo "Wrote $(PLOT)"

clean:
	rm -f $(OBJ) $(BIN) $(PLOT)
